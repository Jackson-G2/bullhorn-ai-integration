# Bullhorn CRM Credentials
# Get these from your Bullhorn administrator
BH_CLIENT_ID=your_bullhorn_client_id
BH_CLIENT_SECRET=your_bullhorn_client_secret
BH_USERNAME=your_bullhorn_username
BH_PASSWORD=your_bullhorn_password

# Google Gemini API Key
# Get this from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Gemini Model (optional)
GEMINI_MODEL=gemini-3.1-flash-lite

# Configuration
# The custom field in Bullhorn to store rankings (1-4)
RANKING_FIELD=customInt1

# Number of candidates to process per batch (default: 10)
BATCH_SIZE=10

# Job Order ID to process
# Set this before running the integration
JOB_ORDER_ID=12345
